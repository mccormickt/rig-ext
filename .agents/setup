#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
if ! command -v protoc >/dev/null; then
  sudo apt-get update -qq
  sudo apt-get install -y protobuf-compiler
fi
if ! command -v clang >/dev/null || ! command -v wasm-ld >/dev/null; then
  sudo apt-get update -qq
  sudo apt-get install -y clang lld
fi
if ! command -v cargo >/dev/null; then
  installer=$(mktemp)
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o "$installer"
  sh "$installer" -y --profile minimal
  rm "$installer"
fi
rustup component add clippy rustfmt
rustup target add wasm32-unknown-unknown
if ! command -v temporal >/dev/null; then
  archive=$(mktemp)
  mkdir -p "$HOME/.local/bin"
  curl -sSfL 'https://temporal.download/cli/archive/latest?platform=linux&arch=amd64' -o "$archive"
  tar -xzf "$archive" -C "$HOME/.local/bin" temporal
  rm "$archive"
fi
cargo fetch --locked
./scripts/workers/install.sh
if [[ "$(wasm-bindgen --version 2>/dev/null || true)" != "wasm-bindgen 0.2.129" ]]; then
  cargo install wasm-bindgen-cli --version 0.2.129 --locked
fi

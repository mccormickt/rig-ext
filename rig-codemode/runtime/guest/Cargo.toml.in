[package]
name = "rig-codemode-worker-runtime"
version = "0.1.0"
edition = "2024"
license = "MIT"
publish = false

[workspace]

[lib]
crate-type = ["cdylib"]

[dependencies]
rig-codemode = { package = "rig-codemode-core", path = @CORE@, default-features = false, features = ["worker-runtime"] }
rquickjs = { version = "=0.14.0", default-features = false, features = ["std"] }
wasm-bindgen = { version = "=0.2.129", optional = true }
worker = { version = "=0.8.3", optional = true }

[features]
workers = ["dep:worker", "dep:wasm-bindgen"]

[profile.release]
opt-level = "s"
lto = true
strip = true
